{
  "name": "auto-web-upload",
  "version": "1.5.1",
  "description": "Linux 服务器文件自动部署工具",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build && electron-builder",
    "preview": "vite preview",
    "rebuild": "electron-rebuild",
    "debug": "vite --mode development",
    "debug:electron": "electron --inspect=5858 dist-electron/main/index.js",
    "debug:renderer": "vite --mode development --debug",
    "typecheck": "vue-tsc --noEmit",
    "lint": "echo 'No linting configured'",
    "clean": "rimraf dist dist-electron release"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-log": "^5.4.3",
    "electron-store": "^8.1.0",
    "pinia": "^3.0.4",
    "ssh2": "^1.15.0",
    "ssh2-sftp-client": "^10.0.3",
    "vue": "^3.4.0",
    "vue-router": "^4.6.4",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ssh2": "^1.15.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^26.0.0",
    "electron-builder": "^24.9.0",
    "electron-rebuild": "^3.2.9",
    "lucide-vue-next": "^0.309.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue-tsc": "^2.0.0"
  },
  "build": {
    "appId": "com.autowebupload.app",
    "productName": "Linux 服务器自动部署工具",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "portable"
      ],
      "icon": "favicon.png",
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
